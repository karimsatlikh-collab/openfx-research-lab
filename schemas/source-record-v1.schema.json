{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karimsatlikh-collab/openfx-research-lab/blob/main/schemas/source-record-v1.schema.json",
  "title": "OpenFX SourceRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "identity",
    "rights_basis",
    "permission_evidence",
    "retrieved_at_utc",
    "exact_locator",
    "capture_method",
    "content_sha256",
    "provenance_state",
    "human_approval"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "rights_basis": {
      "enum": [
        "owner_created",
        "explicit_permission",
        "public_domain",
        "licensed"
      ]
    },
    "permission_evidence": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "exact_locator": {
      "type": "string",
      "minLength": 1
    },
    "capture_method": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "$ref": "#/$defs/hash"
    },
    "provenance_state": {
      "enum": [
        "observed",
        "test_confirmed",
        "independently_reproduced",
        "code_reviewed_only",
        "hypothesis",
        "unknown"
      ]
    },
    "human_approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "approved_at_utc",
            "reason"
          ],
          "properties": {
            "actor_id": {
              "type": "string",
              "minLength": 1
            },
            "approved_at_utc": {
              "type": "string",
              "format": "date-time"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rights_basis": {
            "const": "explicit_permission"
          }
        },
        "required": [
          "rights_basis"
        ]
      },
      "then": {
        "properties": {
          "human_approval": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
