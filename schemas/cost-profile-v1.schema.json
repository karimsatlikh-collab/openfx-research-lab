{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karimsatlikh-collab/openfx-research-lab/blob/main/schemas/cost-profile-v1.schema.json",
  "title": "OpenFX CostProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "symbol",
    "spread_model",
    "commission",
    "slippage",
    "swap",
    "symbol_spec",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "spread_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "fixed",
            "historical",
            "per_tick",
            "synthetic"
          ]
        },
        "value_points": {
          "type": "number",
          "minimum": 0
        },
        "source_ref": {
          "type": "string"
        }
      }
    },
    "commission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "basis"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "per_lot_per_side",
            "per_lot_round_turn",
            "per_trade",
            "percent_notional"
          ]
        }
      }
    },
    "slippage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "value_points"
      ],
      "properties": {
        "model": {
          "enum": [
            "fixed",
            "historical",
            "stress_scenario",
            "none"
          ]
        },
        "value_points": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "swap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "enum": [
            "none",
            "fixed_per_lot_per_day",
            "historical"
          ]
        },
        "long_per_lot_per_day": {
          "type": "number"
        },
        "short_per_lot_per_day": {
          "type": "number"
        },
        "triple_swap_day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "symbol_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digits",
        "point_size",
        "contract_size",
        "tick_size",
        "tick_value"
      ],
      "properties": {
        "digits": {
          "type": "integer",
          "minimum": 0
        },
        "point_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "contract_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tick_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tick_value": {
          "type": "number",
          "minimum": 0
        },
        "min_volume": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "volume_step": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  }
}
