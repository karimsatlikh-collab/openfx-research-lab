{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenFX Evidence-Linked Claim Register v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_text",
          "classification",
          "review_status",
          "rationale",
          "evidence",
          "contradiction_group"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "source_confirmed",
              "source_claim",
              "interpretation",
              "hypothesis",
              "unknown"
            ]
          },
          "review_status": {
            "enum": [
              "draft",
              "human_verified",
              "needs_review",
              "rejected"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "segment_id",
                "quote"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
                },
                "segment_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "contradiction_group": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "enum": [
                    "source_confirmed",
                    "source_claim"
                  ]
                }
              },
              "required": [
                "classification"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "source_confirmed"
                }
              },
              "required": [
                "classification"
              ]
            },
            "then": {
              "properties": {
                "review_status": {
                  "const": "human_verified"
                },
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
