{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karimsatlikh-collab/openfx-research-lab/blob/main/schemas/experiment-v1.schema.json",
  "title": "OpenFX Experiment Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "created_at_utc",
    "updated_at_utc",
    "status",
    "hypothesis",
    "strategy_version",
    "market",
    "parameters",
    "execution",
    "result",
    "artifacts",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "FAILED"
      ]
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "strategy_version": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "object",
      "required": [
        "symbol",
        "timeframe",
        "data_start",
        "data_end"
      ],
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "timeframe": {
          "type": "string",
          "minLength": 1
        },
        "data_start": {
          "type": "string",
          "format": "date"
        },
        "data_end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "worker_version",
        "started_at_utc",
        "finished_at_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "worker_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\\\\\).+$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "error": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "QUEUED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "started_at_utc": {
                "type": "null"
              },
              "finished_at_utc": {
                "type": "null"
              }
            }
          },
          "result": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "RUNNING"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "started_at_utc": {
                "type": "string",
                "format": "date-time"
              },
              "finished_at_utc": {
                "type": "null"
              }
            }
          },
          "result": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "started_at_utc": {
                "type": "string",
                "format": "date-time"
              },
              "finished_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "result": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "finished_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "properties": {
              "finished_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
