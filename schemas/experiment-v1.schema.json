{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karimsatlikh-collab/openfx-research-lab/blob/main/schemas/experiment-v1.schema.json",
  "title": "OpenFX Experiment Manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "experiment_id",
    "created_at_utc",
    "updated_at_utc",
    "status",
    "hypothesis",
    "strategy_version",
    "market",
    "parameters",
    "execution",
    "result",
    "artifacts",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "updated_at_utc": { "type": "string", "format": "date-time" },
    "status": { "enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED"] },
    "hypothesis": { "type": "string", "minLength": 1 },
    "strategy_version": { "type": "string", "minLength": 1 },
    "market": {
      "type": "object",
      "required": ["symbol", "timeframe", "data_start", "data_end"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "timeframe": { "type": "string", "minLength": 1 },
        "data_start": { "type": "string", "format": "date" },
        "data_end": { "type": "string", "format": "date" }
      },
      "additionalProperties": true
    },
    "parameters": { "type": "object" },
    "execution": {
      "type": "object",
      "required": ["mode", "worker_version", "started_at_utc", "finished_at_utc"],
      "properties": {
        "mode": { "type": "string" },
        "worker_version": { "type": ["string", "null"] },
        "started_at_utc": { "type": ["string", "null"] },
        "finished_at_utc": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "result": { "type": ["object", "null"] },
    "artifacts": { "type": "array" },
    "notes": { "type": "string" },
    "error": { "type": "string", "maxLength": 2000 }
  }
}
