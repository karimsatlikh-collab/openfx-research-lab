{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karimsatlikh-collab/openfx-research-lab/blob/main/schemas/gate-config-v1.schema.json",
  "title": "OpenFX GateConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "version",
    "frozen_before_trials",
    "trial_family_policy",
    "data_split",
    "multiple_testing_method",
    "acceptance_thresholds",
    "cost_sensitivity_scenarios",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gate_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "frozen_before_trials": {
      "const": true
    },
    "trial_family_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "max_trials",
        "count_failures_and_abandoned"
      ],
      "properties": {
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "max_trials": {
          "type": "integer",
          "minimum": 1
        },
        "count_failures_and_abandoned": {
          "const": true
        }
      }
    },
    "data_split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development",
        "validation",
        "final_oos"
      ],
      "properties": {
        "development": {
          "type": "string",
          "minLength": 1
        },
        "validation": {
          "type": "string",
          "minLength": 1
        },
        "final_oos": {
          "type": "string",
          "minLength": 1
        },
        "final_oos_access_policy": {
          "enum": [
            "single_use",
            "restricted_human_only",
            "other_documented"
          ]
        }
      }
    },
    "multiple_testing_method": {
      "enum": [
        "DSR",
        "PBO",
        "familywise_error",
        "other_pre_registered"
      ]
    },
    "acceptance_thresholds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "boolean",
          "string"
        ]
      }
    },
    "cost_sensitivity_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "description",
          "cost_multiplier"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "cost_multiplier": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  }
}
