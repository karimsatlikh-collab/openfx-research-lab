{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karimsatlikh-collab/openfx-research-lab/blob/main/schemas/data-profile-v1.schema.json",
  "title": "OpenFX DataProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "source",
    "symbol",
    "timeframe",
    "date_range",
    "price_data_mode",
    "data_sha256",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "dataset_id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "license_or_access_basis": {
          "type": "string"
        },
        "retrieved_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "timeframe": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_utc",
        "end_utc"
      ],
      "properties": {
        "start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "price_data_mode": {
      "enum": [
        "ticks",
        "real_ticks",
        "ohlc",
        "synthetic"
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "data_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}
