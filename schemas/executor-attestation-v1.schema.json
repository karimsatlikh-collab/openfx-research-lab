{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karimsatlikh-collab/openfx-research-lab/blob/main/schemas/executor-attestation-v1.schema.json",
  "title": "OpenFX Executor Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key_id", "executor_id", "job_id", "run_id", "job_spec_sha256", "run_record_sha256",
    "engine", "implementation_sha256", "nonce", "issued_at_utc",
    "expires_at_utc", "signature"
  ],
  "properties": {
    "key_id": {"type": "string", "minLength": 1},
    "executor_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "job_spec_sha256": {"$ref": "#/$defs/sha256"},
    "run_record_sha256": {"$ref": "#/$defs/sha256"},
    "engine": {"enum": ["mock", "synthetic", "mt5-demo"]},
    "implementation_sha256": {"$ref": "#/$defs/sha256"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
