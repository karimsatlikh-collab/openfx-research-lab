{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenFX Independent Validator Run Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "job_id", "status", "evidence_level", "timestamps", "inputs", "outputs"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "status": {"const": "COMPLETED"},
    "evidence_level": {"enum": ["mock", "synthetic", "mt5-demo"]},
    "timestamps": {
      "type": "object", "additionalProperties": false,
      "required": ["finished_at_utc"],
      "properties": {"finished_at_utc": {"type": "string", "format": "date-time"}}
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["job_spec_sha256", "implementation_sha256"],
      "properties": {
        "job_spec_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "outputs": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 536870912},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}