{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenFX Independent Validator Job Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "requested_engine", "implementation", "authorization", "expected_outputs"],
  "properties": {
    "schema_version": {"const": 2},
    "job_id": {"type": "string", "minLength": 1},
    "requested_engine": {"enum": ["mock", "synthetic", "mt5-demo"]},
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["build_sha256"],
      "properties": {"build_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["nonce"],
      "properties": {"nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"}}
    },
    "expected_outputs": {
      "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}