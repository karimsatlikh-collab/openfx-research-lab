{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karimsatlikh-collab/openfx-research-lab/blob/main/schemas/independent-job-v1.schema.json",
  "title": "OpenFX Independent Validator Job Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "requested_engine", "implementation", "authorization"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1},
    "requested_engine": {"enum": ["mock", "synthetic", "mt5-demo"]},
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_sha256"],
      "properties": {
        "build_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce"],
      "properties": {
        "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"}
      }
    }
  }
}
